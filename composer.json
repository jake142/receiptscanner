{
    "name": "jake142/receiptscanner",
    "description": "ReceiptScanner is a Laravel AI provider wrapper for scanning receipt images and PDFs into structured receipt JSON via OpenAI, Azure OpenAI, Gemini, and Anthropic provider APIs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Jake142\\ReceiptScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jake142\\ReceiptScanner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jake142\\ReceiptScanner\\ReceiptScannerServiceProvider"
            ],
            "aliases": {
                "ReceiptScanner": "Jake142\\ReceiptScanner\\Facades\\ReceiptScanner"
            }
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "0.1.9"
}
